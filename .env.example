# Copy to .env (gitignored) and fill in the secrets. Defaults are safe for local dev.

# Postgres (hosts hundred_acre_market and hundred_acre_spend). Published on POSTGRES_BIND:POSTGRES_PORT.
# The password only takes effect when the hundred_acre_pg volume is first created.
POSTGRES_PASSWORD=hundred_acre
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5433

# Web app (Caddy). Set WEB_BIND=0.0.0.0 to open the app to your LAN; there is no authentication.
WEB_BIND=127.0.0.1
WEB_PORT=8100

# Fine-grained GitHub token with Issues read on hundred-acre only. Blank: Spend views report GitHub unavailable.
GH_TOKEN_READ=

# Market files: DuckLake Parquet (lake/) and Massive response bodies (responses/) live here, side by side so the
# offsite Parquet sync can exclude responses. Must be an ABSOLUTE path; it is mounted at the same path in the
# containers, so host-side `uv run market ...` with MARKET_DATA_PATH=$HUNDRED_ACRE_DATA_DIR/lake agrees with them.
HUNDRED_ACRE_DATA_DIR=/srv/hundred-acre-data

# Request Engine (ADR-0003). Free tier: 5 Calls/min.
MASSIVE_API_KEY=
MASSIVE_CALLS_PER_MINUTE=5
MASSIVE_MAX_CONCURRENT_CALLS=1

# Spend backup (runs in the scheduler at 02:30 ET). Pushes over HTTPS to the private backup repo.
# BACKUP_GH_TOKEN: fine-grained token with Contents read/write on hundred-acre-backups ONLY (the API never sees it).
BACKUP_REPO_URL=https://github.com/untastedwooze/hundred-acre-backups.git
BACKUP_GH_TOKEN=
# Optional: a failed backup POSTs a short text message here (e.g. an ntfy topic URL). Blank: no alert.
BACKUP_ALERT_URL=
