# Market jobs, run by supercronic in the `scheduler` service. All times are US Eastern (follows DST).
# Every job goes through the Request Engine, whose Priority Classes order nightly ahead of weekly (ADR-0003).
# `backfill` is deliberately not scheduled: run it by hand with `docker compose run --rm`.
CRON_TZ=America/New_York

# nightly: 02:00 Tue-Sat (syncs the reference data first, ADR-0005)
0 2 * * 2-6 market nightly --as-of latest
# weekly: 06:00 Sat
0 6 * * 6 market weekly --as-of latest

# Spend backup (ADR-0001): 02:30 daily. State and failures: see ops/backup/spend-backup.sh.
30 2 * * * bash /opt/hundred-acre/backup/spend-backup.sh
