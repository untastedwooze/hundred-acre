[Unit]
Description=hundred-acre Request Engine (the only process that calls Massive, ADR-0003)

[Service]
Type=simple
# All configuration is environment variables (see README "Request Engine"); nothing else is host-specific.
EnvironmentFile=%h/.config/hundred-acre/request-engine.env
WorkingDirectory=%h/honey-tree/hundred-acre/backend
ExecStart=%h/.local/bin/uv run market request-engine run
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
